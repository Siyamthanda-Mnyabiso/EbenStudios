# Public values (safe in the browser). Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only, used by `npm run seed` ONLY. Never prefix with VITE_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=admin@ebenstudios.com
ADMIN_PASSWORD=choose-a-strong-password
